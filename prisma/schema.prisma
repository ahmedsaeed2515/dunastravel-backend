model Payment {
  id                  String         @id @default(uuid())
  bookingId           String         @map("booking_id")
  /// Gateway name for new attempts. Nullable to preserve legacy financial history.
  provider            String?        @db.VarChar(50)
  providerEnvironment String?        @map("provider_environment") @db.VarChar(20)
  merchantReference   String?        @map("merchant_reference") @db.VarChar(255)
  providerPaymentId   String?        @map("provider_payment_id") @db.VarChar(255)
  attemptNumber       Int?           @map("attempt_number")
  idempotencyKey      String?        @unique @map("idempotency_key") @db.VarChar(100)
  amount              Decimal        @db.Decimal(10, 2)
  currency            String         @default("USD") @db.VarChar(10)
  method              String         @db.VarChar(100)
  transactionId       String?        @map("transaction_id") @db.VarChar(255)
  /// Checkout URL returned by the gateway. Stored so we can replay it on duplicate initiation
  /// without creating a second provider session. Null for admin-added payments.
  sessionUrl          String?        @map("session_url")
  status              PaymentStatus  @default(PENDING)
  providerStatus      String?        @map("provider_status") @db.VarChar(100)
  providerStatusRaw   String?        @map("provider_status_raw") @db.Text
  isRefund            Boolean        @default(false) @map("is_refund")
  paidAt              DateTime?      @map("paid_at")
  failedAt            DateTime?      @map("failed_at")
  cancelledAt         DateTime?      @map("cancelled_at")
  refundedAt          DateTime?      @map("refunded_at")
  failureCode         String?        @map("failure_code") @db.VarChar(100)
  failureMessage      String?        @map("failure_message") @db.Text
  metadata            Json?
  expiresAt           DateTime?      @map("expires_at")
  providerAuthCode    String?        @map("provider_auth_code") @db.VarChar(100)
  lastProviderCheckAt DateTime?      @map("last_provider_check_at")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")
  booking             Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  invoices            Invoice[]
  refunds             RefundRecord[]

  @@unique([bookingId, attemptNumber])
  @@unique([provider, providerPaymentId])
  @@index([bookingId])
  @@index([provider, merchantReference])
  @@index([provider, providerPaymentId])
  @@index([status, createdAt])
  // Note: A partial unique index (bookingId WHERE status='PENDING') is enforced via raw SQL
  // in the accompanying migration: idx_payments_one_pending_per_booking
  @@map("payments")
}

