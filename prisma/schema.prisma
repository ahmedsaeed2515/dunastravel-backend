generator client {
  provider      = "prisma-client-js"
  engineType    = "library"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String                  @id @default(uuid())
  name                   String                  @db.VarChar(255)
  email                  String                  @unique @db.VarChar(255)
  phone                  String?                 @db.VarChar(50)
  passwordHash           String                  @map("password_hash") @db.VarChar(255)
  role                   UserRole                @default(USER)
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  deletedAt              DateTime?               @map("deleted_at")
  address                Json?
  companyId              String?                 @map("company_id")
  customerNumber         String?                 @unique @map("customer_number") @db.VarChar(50)
  customerSource         String?                 @map("customer_source") @db.VarChar(50)
  dateOfBirth            DateTime?               @map("date_of_birth") @db.Date
  emergencyContact       Json?                   @map("emergency_contact")
  familyMembers          Json?                   @map("family_members")
  futureCommissionPlan   String?                 @map("future_commission_plan") @db.VarChar(100)
  futureWalletId         String?                 @map("future_wallet_id") @db.VarChar(100)
  gender                 String?                 @db.VarChar(50)
  isVerified             Boolean                 @default(false) @map("is_verified")
  emailVerifiedAt        DateTime?               @map("email_verified_at")
  isVip                  Boolean                 @default(false) @map("is_vip")
  marketingConsent       Boolean                 @default(true) @map("marketing_consent")
  nationality            String?                 @db.VarChar(100)
  passportNumber         String?                 @map("passport_number") @db.VarChar(100)
  phoneVerified          Boolean                 @default(false) @map("phone_verified")
  preferredCurrency      String?                 @default("USD") @map("preferred_currency") @db.VarChar(10)
  preferredDestination   String?                 @map("preferred_destination") @db.VarChar(100)
  preferredLanguage      String?                 @default("en") @map("preferred_language") @db.VarChar(10)
  preferredTravelType    String?                 @map("preferred_travel_type") @db.VarChar(100)
  referralSource         String?                 @map("referral_source") @db.VarChar(100)
  refreshToken           String?                 @map("refresh_token")
  sessionVersion         Int                     @default(0) @map("session_version")
  resetToken             String?                 @map("reset_token") @db.VarChar(255)
  resetTokenExp          DateTime?               @map("reset_token_exp")
  segments               String[]                @default([])
  status                 String                  @default("ACTIVE") @db.VarChar(50)
  tags                   String[]                @default([])
  travelCompanions       Json?                   @map("travel_companions")
  verifyToken            String?                 @map("verify_token") @db.VarChar(255)
  verifyTokenExp         DateTime?               @map("verify_token_exp")
  verifyAttempts         Int                     @default(0) @map("verify_attempts")
  verifySentAt           DateTime?               @map("verify_sent_at")
  suspendedAt            DateTime?               @map("suspended_at")
  suspendReason          String?                 @map("suspend_reason")
  activityLogs           BookingActivityLog[]
  notes                  BookingNote[]
  assignedBookings       Booking[]               @relation("BookingAssignee")
  bookings               Booking[]               @relation("BookingCustomer")
  customerActivityLogs   CustomerActivityLog[]   @relation("CustomerActivityLogsTarget")
  authoredCustomerLogs   CustomerActivityLog[]   @relation("CustomerActivityLogsAuthor")
  customerDocuments      CustomerDocument[]      @relation("CustomerDocuments")
  customerNotes          CustomerNote[]          @relation("CustomerNotesTarget")
  authoredNotes          CustomerNote[]          @relation("CustomerNotesAuthor")
  company                Company?                @relation(fields: [companyId], references: [id])
  assignedInquiries      TailorMadeInquiry[]     @relation("InquiryAssignee")
  tourFavorites          TourFavorite[]
  transportationBookings TransportationBooking[]
  hotelBookings          HotelBooking[]
  promotionRedemptions   PromotionRedemption[]
  reviews                TourReview[]
  inAppNotifications     InAppNotification[]     @relation("UserInAppNotifications")

  @@index([deletedAt])
  @@index([customerNumber])
  @@index([isVip])
  @@index([status])
  @@index([companyId])
  @@index([role, deletedAt])
  @@index([createdAt])
  @@index([name])
  @@map("users")
}

enum InAppNotificationCategory {
  BOOKING
  PAYMENT
  INQUIRY
  TOUR
  WALLET
  COMMISSION
  SYSTEM
}

enum InAppNotificationPriority {
  NORMAL
  HIGH
  URGENT
}

model InAppNotification {
  id         String                    @id @default(uuid())
  userId     String                    @map("user_id")
  category   InAppNotificationCategory @default(SYSTEM)
  priority   InAppNotificationPriority @default(NORMAL)
  title      String                    @db.VarChar(255)
  message    String                    @db.Text
  targetApp  String                    @default("ADMIN") @map("target_app") @db.VarChar(50)
  entityType String?                   @map("entity_type") @db.VarChar(100)
  entityId   String?                   @map("entity_id") @db.VarChar(255)
  deepLink   String?                   @map("deep_link") @db.VarChar(500)
  metadata   Json?
  isRead     Boolean                   @default(false) @map("is_read")
  readAt     DateTime?                 @map("read_at")
  createdAt  DateTime                  @default(now()) @map("created_at")
  updatedAt  DateTime                  @updatedAt @map("updated_at")

  user User @relation("UserInAppNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([userId, category])
  @@map("in_app_notifications")
}

model Company {
  id                String        @id @default(uuid())
  referenceCode     String        @unique @map("reference_code") @db.VarChar(50)
  name              String        @db.VarChar(255)
  companyType       CompanyType   @default(AGENCY) @map("company_type")
  status            CompanyStatus @default(ACTIVE)
  email             String?       @db.VarChar(255)
  phone             String?       @db.VarChar(50)
  website           String?       @db.VarChar(255)
  taxId             String?       @unique @map("tax_id") @db.VarChar(100)
  address           Json?
  primaryContact    Json?         @map("primary_contact")
  commissionRate    Decimal       @default(0.00) @map("commission_rate") @db.Decimal(5, 2)
  currentBalance    Decimal       @default(0.00) @map("current_balance") @db.Decimal(12, 2)
  paymentTerms      String?       @default("NET_30") @map("payment_terms") @db.VarChar(50)
  contractStartDate DateTime?     @map("contract_start_date") @db.Date
  contractEndDate   DateTime?     @map("contract_end_date") @db.Date
  tags              String[]      @default([])
  segments          String[]      @default([])
  tier              String?       @db.VarChar(50)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  deletedAt         DateTime?     @map("deleted_at")
  bookings          Booking[]
  commissions       Commission[]
  users             User[]
  tailorMadeInquiries TailorMadeInquiry[]

  @@index([companyType])
  @@index([status])
  @@index([deletedAt])
  @@map("companies")
}

model CustomerNote {
  id         String   @id @default(uuid())
  customerId String   @map("customer_id")
  userId     String   @map("user_id")
  noteType   String   @default("INTERNAL") @map("note_type") @db.VarChar(50)
  content    String
  isPinned   Boolean  @default(false) @map("is_pinned")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  customer   User     @relation("CustomerNotesTarget", fields: [customerId], references: [id], onDelete: Cascade)
  user       User     @relation("CustomerNotesAuthor", fields: [userId], references: [id])

  @@index([customerId])
  @@index([userId])
  @@index([isPinned])
  @@map("customer_notes")
}

model CustomerDocument {
  id           String     @id @default(uuid())
  customerId   String     @map("customer_id")
  mediaAssetId String     @map("media_asset_id")
  documentType String     @default("OTHER") @map("document_type") @db.VarChar(50)
  title        String     @db.VarChar(255)
  uploadedBy   String?    @map("uploaded_by")
  createdAt    DateTime   @default(now()) @map("created_at")
  customer     User       @relation("CustomerDocuments", fields: [customerId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset @relation("CustomerDocumentMedia", fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@unique([mediaAssetId], map: "customer_documents_media_asset_id_key")
  @@index([customerId])
  @@map("customer_documents")
}

model CustomerActivityLog {
  id         String   @id @default(uuid())
  customerId String   @map("customer_id")
  userId     String?  @map("user_id")
  action     String   @db.VarChar(255)
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at")
  customer   User     @relation("CustomerActivityLogsTarget", fields: [customerId], references: [id], onDelete: Cascade)
  user       User?    @relation("CustomerActivityLogsAuthor", fields: [userId], references: [id])

  @@index([customerId])
  @@map("customer_activity_logs")
}

model Tour {
  id                      String                @id @default(uuid())
  slug                    String                @unique @db.VarChar(255)
  titleJsonb              Json                  @map("title_jsonb")
  subtitleJsonb           Json?                 @map("subtitle_jsonb")
  highlightsJsonb         Json?                 @map("highlights_jsonb")
  departureInfoJsonb      Json?                 @map("departure_info_jsonb")
  sourceCodeJsonb         Json?                 @map("source_code_jsonb")
  sourceCatalogId         String?               @unique @map("source_catalog_id") @db.VarChar(100)
  market                  String?               @db.VarChar(100)
  sourceRating            Decimal?              @map("source_rating") @db.Decimal(3, 2)
  sourceReviewCount       Int?                  @map("source_review_count")
  category                String?               @db.VarChar(100)
  basePriceUsd            Decimal               @map("base_price_usd") @db.Decimal(10, 2)
  durationJsonb           Json?                 @map("duration_jsonb")
  overviewJsonb           Json?                 @map("overview_jsonb")
  minPaxJsonb             Json?                 @map("min_pax_jsonb")
  isActive                Boolean               @default(true) @map("is_active")
  createdAt               DateTime              @default(now()) @map("created_at")
  updatedAt               DateTime              @updatedAt @map("updated_at")
  ageRestrictions         String?               @map("age_restrictions") @db.VarChar(100)
  cancellationPolicyJsonb Json?                 @map("cancellation_policy_jsonb")
  city                    String?               @db.VarChar(100)
  country                 String?               @db.VarChar(100)
  currency                String                @default("USD") @db.VarChar(10)
  originalPrice           Decimal?              @map("original_price") @db.Decimal(10, 2)
  originalCurrency        String?               @map("original_currency") @db.VarChar(10)
  exchangeRate            Decimal?              @map("exchange_rate") @db.Decimal(12, 6)
  exchangeRateDate        DateTime?             @map("exchange_rate_date")
  exchangeRateSource      String?               @map("exchange_rate_source") @db.VarChar(50)
  deletedAt               DateTime?             @map("deleted_at")
  departureTime           String?               @map("departure_time") @db.VarChar(50)
  difficultyLevel         String?               @map("difficulty_level") @db.VarChar(50)
  excludedServicesJsonb   Json?                 @map("excluded_services_jsonb")
  hotelInfoJsonb          Json?                 @map("hotel_info_jsonb")
  includedServicesJsonb   Json?                 @map("included_services_jsonb")
  isFeatured              Boolean               @default(false) @map("is_featured")
  displayOrder            Int                   @default(0) @map("display_order")
  languages               String[]              @default(["en"])
  meetingPoint            String?               @map("meeting_point") @db.VarChar(255)
  pickupLocationsJsonb    Json?                 @map("pickup_locations_jsonb")
  region                  String?               @map("region") @db.VarChar(100)
  returnTime              String?               @map("return_time") @db.VarChar(50)
  seasonPricingJsonb      Json?                 @map("season_pricing_jsonb")
  seoDescription          String?               @map("seo_description")
  seoTitle                String?               @map("seo_title") @db.VarChar(255)
  status                  String                @default("DRAFT") @db.VarChar(50)
  tags                    String[]              @default([])
  termsJsonb              Json?                 @map("terms_jsonb")
  transportationJsonb     Json?                 @map("transportation_jsonb")
  routeMapJsonb           Json?                 @map("route_map_jsonb")
  priceDisplayMode        String                @default("PRICE") @map("price_display_mode") @db.VarChar(20)
  priceLabelJsonb         Json?                 @map("price_label_jsonb")
  bookingRulesJsonb       Json?                 @map("booking_rules_jsonb")
  bookings                Booking[]
  activityLogs            TourActivityLog[]
  images                  TourImage[]
  itineraries             TourItinerary[]
  reviews                 TourReview[]
  favorites               TourFavorite[]
  landingPages            TourLandingPageTour[]
  availabilities          TourAvailability[]
  journeyRoutes           JourneyRoute[]
  accommodations          TripAccommodation[]
  tripHotel               Hotel?                @relation("TourTripHotel")

  @@index([isActive])
  @@index([category])
  @@index([country])
  @@index([city])
  @@index([status])
  @@index([isFeatured])
  @@index([displayOrder])
  @@index([deletedAt])
  @@index([sourceCatalogId])
  @@index([status, isActive, deletedAt, category])
  @@index([status, isActive, deletedAt, country])
  @@index([status, isActive, deletedAt, city])
  @@index([status, isActive, deletedAt, isFeatured])
  @@index([status, isActive, deletedAt, displayOrder])
  @@map("tours")
}

model TourItinerary {
  id                  String   @id @default(uuid())
  tourId              String   @map("tour_id")
  dayLabel            String?  @map("day_label") @db.VarChar(50)
  titleJsonb          Json?    @map("title_jsonb")
  descriptionJsonb    Json     @map("description_jsonb")
  mealsJsonb          Json?    @map("meals_jsonb")
  sortOrder           Int      @map("sort_order")
  createdAt           DateTime @default(now()) @map("created_at")
  activitiesJsonb     Json?    @map("activities_jsonb")
  hotelsJsonb         Json?    @map("hotels_jsonb")
  notesJsonb          Json?    @map("notes_jsonb")
  transportationJsonb Json?    @map("transportation_jsonb")
  tour                Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@index([tourId])
  @@index([sortOrder])
  @@index([tourId, sortOrder])
  @@map("tour_itineraries")
}

model TourImage {
  id        String   @id @default(uuid())
  tourId    String   @map("tour_id")
  imageUrl  String   @map("image_url")
  isHero    Boolean  @default(false) @map("is_hero")
  altText   String?  @map("alt_text") @db.VarChar(255)
  sortOrder Int      @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  isVideo   Boolean  @default(false) @map("is_video")
  videoUrl  String?  @map("video_url")
  tour      Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@index([tourId])
  @@index([isHero])
  @@index([tourId, isHero, sortOrder])
  @@map("tour_images")
}

model TourReview {
  id           String    @id @default(uuid())
  tourId       String    @map("tour_id")
  userId       String?   @map("user_id")
  bookingId    String?   @unique @map("booking_id")
  rating       Int       @default(5)
  reviewerName String    @map("reviewer_name") @db.VarChar(255)
  comment      String?
  adminReply   String?   @map("admin_reply")
  status       String    @default("PENDING") @db.VarChar(50)
  isPublished  Boolean   @default(false) @map("is_published")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")
  tour         Tour      @relation(fields: [tourId], references: [id], onDelete: Cascade)
  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  booking      Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([tourId])
  @@index([userId], map: "idx_tour_reviews_user_id")
  @@index([bookingId], map: "idx_tour_reviews_booking_id")
  @@index([status], map: "idx_tour_reviews_status")
  @@index([tourId, isPublished])
  @@index([tourId, status, isPublished, deletedAt])
  @@index([rating])
  @@index([deletedAt])
  @@map("tour_reviews")
}

model TourActivityLog {
  id        String   @id @default(uuid())
  tourId    String   @map("tour_id")
  userId    String?  @map("user_id")
  action    String   @db.VarChar(255)
  details   Json?
  createdAt DateTime @default(now()) @map("created_at")
  tour      Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@index([tourId])
  @@map("tour_activity_logs")
}

model Booking {
  id                  String               @id @default(uuid())
  referenceCode       String               @unique @map("reference_code") @db.VarChar(20)
  userId              String?              @map("user_id")
  tourId              String               @map("tour_id")
  status              BookingStatus        @default(PENDING)
  arrivalDate         DateTime             @map("arrival_date") @db.Date
  departureDate       DateTime?            @map("departure_date") @db.Date
  arrivalTime         String?              @map("arrival_time") @db.VarChar(20)
  departureTime       String?              @map("departure_time") @db.VarChar(20)
  language            String?              @db.VarChar(10)
  activityType        String?              @map("activity_type") @db.VarChar(50)
  bookingType         String               @default("BOOKING") @map("booking_type") @db.VarChar(20)
  transportChoice     String?              @map("transport_choice") @db.VarChar(100)
  adults              Int                  @default(1)
  children            Int                  @default(0)
  infants             Int                  @default(0)
  totalAmountUsd      Decimal              @map("total_amount_usd") @db.Decimal(10, 2)
  paidAmountUsd       Decimal              @default(0.00) @map("paid_amount_usd") @db.Decimal(10, 2)
  currency            String               @default("USD") @db.VarChar(10)
  originalAmount      Decimal?             @map("original_amount") @db.Decimal(10, 2)
  originalCurrency    String?              @map("original_currency") @db.VarChar(10)
  exchangeRate        Decimal?             @map("exchange_rate") @db.Decimal(10, 6)
  exchangeRateDate    String?              @map("exchange_rate_date") @db.VarChar(20)
  exchangeRateSource  String?              @map("exchange_rate_source") @db.VarChar(50)
  convertedAmount     Decimal?             @map("converted_amount") @db.Decimal(10, 2)
  convertedCurrency   String?              @map("converted_currency") @db.VarChar(10)
  notes               String?
  inquiryMessage      String?              @map("inquiry_message") @db.Text
  analyticsSessionId  String?              @map("analytics_session_id") @db.VarChar(100)
  originInterfaceSlug String?              @map("origin_interface_slug") @db.VarChar(100)
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  assigneeId          String?              @map("assignee_id")
  cancellationReason  String?              @map("cancellation_reason")
  companyId           String?              @map("company_id")
  deletedAt           DateTime?            @map("deleted_at")
  priority            String               @default("MEDIUM") @db.VarChar(20)
  idempotencyKey      String?              @unique @map("idempotency_key") @db.VarChar(100)
  requestHash         String?              @map("request_hash") @db.VarChar(64)
  guestTokenHash      String?              @map("guest_token_hash") @db.VarChar(64)
  tags                String[]
  billingInfo         BillingInfo?
  activityLogs        BookingActivityLog[]
  attachments         BookingAttachment[]
  notesList           BookingNote[]
  assignee            User?                @relation("BookingAssignee", fields: [assigneeId], references: [id])
  company             Company?             @relation(fields: [companyId], references: [id])
  tour                Tour                 @relation(fields: [tourId], references: [id])
  user                User?                @relation("BookingCustomer", fields: [userId], references: [id])
  commission          Commission?
  invoice             Invoice?
  promotionRedemption PromotionRedemption?
  tailorMadeInquiry   TailorMadeInquiry?
  passengers          Passenger[]
  payments            Payment[]
  reviews             TourReview[]

  availabilityId String?           @map("availability_id")
  availability   TourAvailability? @relation(fields: [availabilityId], references: [id])

  @@index([userId])
  @@index([assigneeId])
  @@index([companyId])
  @@index([tourId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([status, createdAt])
  @@index([tourId, createdAt])
  @@index([deletedAt, status, createdAt])
  @@index([deletedAt, tourId, createdAt])
  @@index([userId, tourId, status, deletedAt])
  @@map("bookings")
}

model Passenger {
  id             String    @id @default(uuid())
  bookingId      String    @map("booking_id")
  passengerType  String    @map("passenger_type") @db.VarChar(20)
  fullName       String    @map("full_name") @db.VarChar(255)
  dateOfBirth    DateTime? @map("date_of_birth") @db.Date
  nationality    String?   @db.VarChar(100)
  passportExpiry DateTime? @map("passport_expiry") @db.Date
  passportNumber String?   @map("passport_number") @db.VarChar(100)
  booking        Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("passengers")
}

model BillingInfo {
  id          String      @id @default(uuid())
  bookingId   String      @unique @map("booking_id")
  fullName    String      @map("full_name") @db.VarChar(255)
  email       String      @db.VarChar(255)
  phone       String      @db.VarChar(50)
  invoiceType InvoiceType @default(PERSONAL) @map("invoice_type")
  companyName String?     @map("company_name") @db.VarChar(255)
  taxId       String?     @map("tax_id") @db.VarChar(100)
  address     String?     @db.VarChar(500)
  city        String?     @db.VarChar(100)
  country     String?     @db.VarChar(100)
  booking     Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("billing_info")
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique @map("invoice_number") @db.VarChar(30)
  bookingId     String        @unique @map("booking_id")
  issuedAt      DateTime      @default(now()) @map("issued_at")
  status        InvoiceStatus @default(DRAFT)
  subtotal      Decimal       @default(0.00) @db.Decimal(10, 2)
  tax           Decimal       @default(0.00) @db.Decimal(10, 2)
  total         Decimal       @default(0.00) @db.Decimal(10, 2)
  currency      String        @default("USD") @db.VarChar(10)
  exchangeRate  Decimal?      @map("exchange_rate") @db.Decimal(10, 6)
  exchangeRateDate String?    @map("exchange_rate_date") @db.VarChar(20)
  snapshotJsonb Json?         @map("snapshot_jsonb")
  dueDate       DateTime?     @map("due_date")
  pdfUrl        String?       @map("pdf_url")
  paymentId     String?       @map("payment_id")

  payment Payment? @relation(fields: [paymentId], references: [id])
  booking Booking  @relation(fields: [bookingId], references: [id])

  @@map("invoices")
}

model TailorMadeInquiry {
  id                String                  @id @default(uuid())
  referenceCode     String                  @unique @map("reference_code") @db.VarChar(20)
  fullName          String                  @map("full_name") @db.VarChar(255)
  email             String                  @db.VarChar(255)
  phone             String                  @db.VarChar(50)
  preferredLanguage String                  @map("preferred_language") @db.VarChar(10)
  destinations      String[]
  startDate         DateTime?               @map("start_date") @db.Date
  endDate           DateTime?               @map("end_date") @db.Date
  adults            Int
  children          Int                     @default(0)
  budgetAmount      Decimal?                @map("budget_amount") @db.Decimal(10, 2)
  budgetCurrency    String?                 @map("budget_currency") @db.VarChar(10)
  notes             String?
  partnerCode       String?                 @map("partner_code") @db.VarChar(50)
  companyId         String?                 @map("company_id")
  assigneeId        String?                 @map("assignee_id")
  followUpAt        DateTime?               @map("follow_up_at")
  internalNote      String?                 @map("internal_note")
  quotedAmountUsd   Decimal?                @map("quoted_amount_usd") @db.Decimal(10, 2)
  bookingId         String?                 @unique @map("booking_id")
  status            TailorMadeInquiryStatus @default(NEWLY_RECEIVED)
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")
