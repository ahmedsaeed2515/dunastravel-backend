  title                String            @db.VarChar(255)
  content              String            @db.Text
  locale               String            @default("en") @db.VarChar(10)
  category             KnowledgeCategory @default(GENERAL)
  tags                 String[]          @default([])
  status               KnowledgeStatus   @default(PUBLISHED)
  source               String?           @db.VarChar(255)
  sourceType           String?           @map("source_type") @db.VarChar(50)
  sourceEntityType     String?           @map("source_entity_type") @db.VarChar(50)
  sourceEntityId       String?           @map("source_entity_id") @db.VarChar(100)
  contentHash          String?           @map("content_hash") @db.VarChar(64)
  isAutoGenerated      Boolean           @default(false) @map("is_auto_generated")
  isManuallyOverridden Boolean           @default(false) @map("is_manually_overridden")
  isExcludedFromAi     Boolean           @default(false) @map("is_excluded_from_ai")
  isRecommendationAllowed Boolean        @default(true) @map("is_recommendation_allowed")
  aiOverrideInstructions  String?        @map("ai_override_instructions") @db.Text
  aiOverrideContext       String?        @map("ai_override_context") @db.Text
  adminNotes              String?        @map("admin_notes") @db.Text
  syncStatus           String            @default("IDLE") @map("sync_status") @db.VarChar(30)
  priority             Int               @default(0)
  validityStart        DateTime?         @map("validity_start")
  validityEnd          DateTime?         @map("validity_end")
  version              Int               @default(1)
  lastIndexedAt        DateTime?         @map("last_indexed_at")
  lastSyncedAt         DateTime?         @map("last_synced_at")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  @@index([category])
  @@index([locale])
  @@index([status])
  @@index([priority])
  @@index([sourceEntityType, sourceEntityId])
  @@index([isAutoGenerated])
  @@index([isExcludedFromAi])
  @@map("knowledge_base_items")
}

model AiKnowledgeVersion {
  id                     String    @id @default(uuid())
  knowledgeItemId        String    @map("knowledge_item_id")
  versionNumber          Int       @map("version_number")
  title                  String    @db.VarChar(255)
  content                String    @db.Text
  locale                 String    @default("en") @db.VarChar(10)
  aiOverrideInstructions String?   @map("ai_override_instructions") @db.Text
  changeSummary          String?   @map("change_summary") @db.VarChar(500)
  changedBy              String?   @map("changed_by") @db.VarChar(255)
  createdAt              DateTime  @default(now()) @map("created_at")

  @@index([knowledgeItemId])
  @@index([versionNumber])
  @@map("ai_knowledge_versions")
}

model AiUsageLog {
  id               String   @id @default(uuid())
  provider         String   @db.VarChar(50)
  model            String   @db.VarChar(100)
  inputTokens      Int      @default(0) @map("input_tokens")
  outputTokens     Int      @default(0) @map("output_tokens")
  estimatedCostUsd Decimal  @default(0.00) @map("estimated_cost_usd") @db.Decimal(10, 6)
  latencyMs        Int      @default(0) @map("latency_ms")
  isSuccess        Boolean  @default(true) @map("is_success")
  errorCategory    String?  @map("error_category") @db.VarChar(100)
  conversationId   String?  @map("conversation_id")
  sessionId        String?  @map("session_id")
  endpoint         String   @db.VarChar(100)
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([provider])
  @@index([model])
  @@index([isSuccess])
  @@index([createdAt])
  @@map("ai_usage_logs")
}

