generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String                @id @default(uuid())
  name                 String                @db.VarChar(255)
  email                String                @unique @db.VarChar(255)
  phone                String?               @db.VarChar(50)
  passwordHash         String                @map("password_hash") @db.VarChar(255)
  role                 UserRole              @default(USER)
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  deletedAt            DateTime?             @map("deleted_at")
  address              Json?
  companyId            String?               @map("company_id")
  customerNumber       String?               @unique @map("customer_number") @db.VarChar(50)
  customerSource       String?               @map("customer_source") @db.VarChar(50)
  dateOfBirth          DateTime?             @map("date_of_birth") @db.Date
  emergencyContact     Json?                 @map("emergency_contact")
  familyMembers        Json?                 @map("family_members")
  futureCommissionPlan String?               @map("future_commission_plan") @db.VarChar(100)
  futureWalletId       String?               @map("future_wallet_id") @db.VarChar(100)
  gender               String?               @db.VarChar(50)
  isVerified           Boolean               @default(false) @map("is_verified")
  isVip                Boolean               @default(false) @map("is_vip")
  marketingConsent     Boolean               @default(true) @map("marketing_consent")
  nationality          String?               @db.VarChar(100)
  passportNumber       String?               @map("passport_number") @db.VarChar(100)
  phoneVerified        Boolean               @default(false) @map("phone_verified")
  preferredCurrency    String?               @default("USD") @map("preferred_currency") @db.VarChar(10)
  preferredDestination String?               @map("preferred_destination") @db.VarChar(100)
  preferredLanguage    String?               @default("en") @map("preferred_language") @db.VarChar(10)
  preferredTravelType  String?               @map("preferred_travel_type") @db.VarChar(100)
  referralSource       String?               @map("referral_source") @db.VarChar(100)
  refreshToken         String?               @map("refresh_token")
  resetToken           String?               @map("reset_token") @db.VarChar(255)
  resetTokenExp        DateTime?             @map("reset_token_exp")
  segments             String[]              @default([])
  status               String                @default("ACTIVE") @db.VarChar(50)
  tags                 String[]              @default([])
  travelCompanions     Json?                 @map("travel_companions")
  verifyToken          String?               @map("verify_token") @db.VarChar(255)
  activityLogs         BookingActivityLog[]
  notes                BookingNote[]
  assignedBookings     Booking[]             @relation("BookingAssignee")
  bookings             Booking[]             @relation("BookingCustomer")
  customerActivityLogs CustomerActivityLog[] @relation("CustomerActivityLogsTarget")
  authoredCustomerLogs CustomerActivityLog[] @relation("CustomerActivityLogsAuthor")
  customerDocuments    CustomerDocument[]    @relation("CustomerDocuments")
  customerNotes        CustomerNote[]        @relation("CustomerNotesTarget")
  authoredNotes        CustomerNote[]        @relation("CustomerNotesAuthor")
  company              Company?              @relation(fields: [companyId], references: [id])

  @@index([deletedAt])
  @@index([customerNumber])
  @@index([isVip])
  @@index([status])
  @@index([companyId])
  @@map("users")
}

model Company {
  id                String        @id @default(uuid())
  referenceCode     String        @unique @map("reference_code") @db.VarChar(50)
  name              String        @db.VarChar(255)
  companyType       CompanyType   @default(AGENCY) @map("company_type")
  status            CompanyStatus @default(ACTIVE)
  email             String?       @db.VarChar(255)
  phone             String?       @db.VarChar(50)
  website           String?       @db.VarChar(255)
  address           Json?
  primaryContact    Json?         @map("primary_contact")
  commissionRate    Decimal       @default(0.00) @map("commission_rate") @db.Decimal(5, 2)
  currentBalance    Decimal       @default(0.00) @map("current_balance") @db.Decimal(12, 2)
  paymentTerms      String?       @default("NET_30") @map("payment_terms") @db.VarChar(50)
  contractStartDate DateTime?     @map("contract_start_date") @db.Date
  contractEndDate   DateTime?     @map("contract_end_date") @db.Date
  tags              String[]      @default([])
  segments          String[]      @default([])
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  deletedAt         DateTime?     @map("deleted_at")
  bookings          Booking[]
  commissions       Commission[]
  users             User[]

  @@index([companyType])
  @@index([status])
  @@index([deletedAt])
  @@map("companies")
}

model CustomerNote {
  id         String   @id @default(uuid())
  customerId String   @map("customer_id")
  userId     String   @map("user_id")
  noteType   String   @default("INTERNAL") @map("note_type") @db.VarChar(50)
  content    String
  isPinned   Boolean  @default(false) @map("is_pinned")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  customer   User     @relation("CustomerNotesTarget", fields: [customerId], references: [id], onDelete: Cascade)
  user       User     @relation("CustomerNotesAuthor", fields: [userId], references: [id])

  @@index([customerId])
  @@index([userId])
  @@index([isPinned])
  @@map("customer_notes")
}

model CustomerDocument {
  id           String   @id @default(uuid())
  customerId   String   @map("customer_id")
  mediaAssetId String   @map("media_asset_id")
  documentType String   @default("OTHER") @map("document_type") @db.VarChar(50)
  title        String   @db.VarChar(255)
  uploadedBy   String?  @map("uploaded_by")
  createdAt    DateTime @default(now()) @map("created_at")
  customer     User     @relation("CustomerDocuments", fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_documents")
}

model CustomerActivityLog {
  id         String   @id @default(uuid())
  customerId String   @map("customer_id")
  userId     String?  @map("user_id")
  action     String   @db.VarChar(255)
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at")
  customer   User     @relation("CustomerActivityLogsTarget", fields: [customerId], references: [id], onDelete: Cascade)
  user       User?    @relation("CustomerActivityLogsAuthor", fields: [userId], references: [id])

  @@index([customerId])
  @@map("customer_activity_logs")
}

model Tour {
  id                      String            @id @default(uuid())
  slug                    String            @unique @db.VarChar(255)
  titleJsonb              Json              @map("title_jsonb")
  category                String?           @db.VarChar(100)
  basePriceUsd            Decimal           @map("base_price_usd") @db.Decimal(10, 2)
  durationJsonb           Json?             @map("duration_jsonb")
  overviewJsonb           Json?             @map("overview_jsonb")
  minPaxJsonb             Json?             @map("min_pax_jsonb")
  isActive                Boolean           @default(true) @map("is_active")
  createdAt               DateTime          @default(now()) @map("created_at")
  updatedAt               DateTime          @updatedAt @map("updated_at")
  ageRestrictions         String?           @map("age_restrictions") @db.VarChar(100)
  cancellationPolicyJsonb Json?             @map("cancellation_policy_jsonb")
  capacity                Int               @default(30)
  city                    String?           @db.VarChar(100)
  country                 String?           @db.VarChar(100)
  currency                String            @default("USD") @db.VarChar(10)
  deletedAt               DateTime?         @map("deleted_at")
  departureTime           String?           @map("departure_time") @db.VarChar(50)
  difficultyLevel         String?           @map("difficulty_level") @db.VarChar(50)
  excludedServicesJsonb   Json?             @map("excluded_services_jsonb")
  hotelInfoJsonb          Json?             @map("hotel_info_jsonb")
  includedServicesJsonb   Json?             @map("included_services_jsonb")
  isFeatured              Boolean           @default(false) @map("is_featured")
  languages               String[]          @default(["en"])
  meetingPoint            String?           @map("meeting_point") @db.VarChar(255)
  pickupLocationsJsonb    Json?             @map("pickup_locations_jsonb")
  region                  String?           @db.VarChar(100)
  remainingSeats          Int               @default(30) @map("remaining_seats")
  returnTime              String?           @map("return_time") @db.VarChar(50)
  seasonPricingJsonb      Json?             @map("season_pricing_jsonb")
  seoDescription          String?           @map("seo_description")
  seoTitle                String?           @map("seo_title") @db.VarChar(255)
  status                  String            @default("PUBLISHED") @db.VarChar(50)
  tags                    String[]          @default([])
  termsJsonb              Json?             @map("terms_jsonb")
  transportationJsonb     Json?             @map("transportation_jsonb")
  bookings                Booking[]
  activityLogs            TourActivityLog[]
  images                  TourImage[]
  itineraries             TourItinerary[]
  reviews                 TourReview[]

  @@index([isActive])
  @@index([category])
  @@index([country])
  @@index([city])
  @@index([status])
  @@index([isFeatured])
  @@index([deletedAt])
  @@map("tours")
}

model TourItinerary {
  id                  String   @id @default(uuid())
  tourId              String   @map("tour_id")
  dayLabel            String?  @map("day_label") @db.VarChar(50)
  descriptionJsonb    Json     @map("description_jsonb")
  mealsJsonb          Json?    @map("meals_jsonb")
  sortOrder           Int      @map("sort_order")
  createdAt           DateTime @default(now()) @map("created_at")
  activitiesJsonb     Json?    @map("activities_jsonb")
  hotelsJsonb         Json?    @map("hotels_jsonb")
  notesJsonb          Json?    @map("notes_jsonb")
  transportationJsonb Json?    @map("transportation_jsonb")
  tour                Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@index([tourId])
  @@index([sortOrder])
  @@map("tour_itineraries")
}

model TourImage {
  id        String   @id @default(uuid())
  tourId    String   @map("tour_id")
  imageUrl  String   @map("image_url")
  isHero    Boolean  @default(false) @map("is_hero")
  altText   String?  @map("alt_text") @db.VarChar(255)
  sortOrder Int      @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  isVideo   Boolean  @default(false) @map("is_video")
  videoUrl  String?  @map("video_url")
  tour      Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@index([tourId])
  @@index([isHero])
  @@map("tour_images")
}

model TourReview {
  id           String    @id @default(uuid())
  tourId       String    @map("tour_id")
  rating       Int       @default(5)
  reviewerName String    @map("reviewer_name") @db.VarChar(255)
  comment      String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")
  tour         Tour      @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@index([tourId])
  @@index([rating])
  @@index([deletedAt])
  @@map("tour_reviews")
}

model TourActivityLog {
  id        String   @id @default(uuid())
  tourId    String   @map("tour_id")
  userId    String?  @map("user_id")
  action    String   @db.VarChar(255)
  details   Json?
  createdAt DateTime @default(now()) @map("created_at")
  tour      Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@index([tourId])
  @@map("tour_activity_logs")
}

model Booking {
  id                 String               @id @default(uuid())
  referenceCode      String               @unique @map("reference_code") @db.VarChar(20)
  userId             String?              @map("user_id")
  tourId             String               @map("tour_id")
  status             BookingStatus        @default(PENDING)
  arrivalDate        DateTime             @map("arrival_date") @db.Date
  departureDate      DateTime?            @map("departure_date") @db.Date
  transportChoice    String?              @map("transport_choice") @db.VarChar(100)
  adults             Int                  @default(1)
  children           Int                  @default(0)
  infants            Int                  @default(0)
  totalAmountUsd     Decimal              @map("total_amount_usd") @db.Decimal(10, 2)
  notes              String?
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  assigneeId         String?              @map("assignee_id")
  cancellationReason String?              @map("cancellation_reason")
  companyId          String?              @map("company_id")
  deletedAt          DateTime?            @map("deleted_at")
  priority           String               @default("MEDIUM") @db.VarChar(20)
  tags               String[]
  billingInfo        BillingInfo?
  activityLogs       BookingActivityLog[]
  attachments        BookingAttachment[]
  notesList          BookingNote[]
  assignee           User?                @relation("BookingAssignee", fields: [assigneeId], references: [id])
  company            Company?             @relation(fields: [companyId], references: [id])
  tour               Tour                 @relation(fields: [tourId], references: [id])
  user               User?                @relation("BookingCustomer", fields: [userId], references: [id])
  commission         Commission?
  invoice            Invoice?
  passengers         Passenger[]
  payments           Payment[]

  @@index([userId])
  @@index([assigneeId])
  @@index([companyId])
  @@index([tourId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("bookings")
}

model Passenger {
  id             String    @id @default(uuid())
  bookingId      String    @map("booking_id")
  passengerType  String    @map("passenger_type") @db.VarChar(20)
  fullName       String    @map("full_name") @db.VarChar(255)
  dateOfBirth    DateTime? @map("date_of_birth") @db.Date
  nationality    String?   @db.VarChar(100)
  passportExpiry DateTime? @map("passport_expiry") @db.Date
  passportNumber String?   @map("passport_number") @db.VarChar(100)
  booking        Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("passengers")
}

model BillingInfo {
  id          String      @id @default(uuid())
  bookingId   String      @unique @map("booking_id")
  fullName    String      @map("full_name") @db.VarChar(255)
  email       String      @db.VarChar(255)
  phone       String      @db.VarChar(50)
  invoiceType InvoiceType @default(PERSONAL) @map("invoice_type")
  companyName String?     @map("company_name") @db.VarChar(255)
  taxId       String?     @map("tax_id") @db.VarChar(100)
  address     String?     @db.VarChar(500)
  city        String?     @db.VarChar(100)
  country     String?     @db.VarChar(100)
  booking     Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("billing_info")
}

model Invoice {
  id            String   @id @default(uuid())
  invoiceNumber String   @unique @map("invoice_number") @db.VarChar(30)
  bookingId     String   @unique @map("booking_id")
  issuedAt      DateTime @default(now()) @map("issued_at")
  booking       Booking  @relation(fields: [bookingId], references: [id])

  @@map("invoices")
}

model TailorMadeInquiry {
  id                String                  @id @default(uuid())
  referenceCode     String                  @unique @map("reference_code") @db.VarChar(20)
  fullName          String                  @map("full_name") @db.VarChar(255)
  email             String                  @db.VarChar(255)
  phone             String                  @db.VarChar(50)
  preferredLanguage String                  @map("preferred_language") @db.VarChar(10)
  destinations      String[]
  startDate         DateTime?               @map("start_date") @db.Date
  endDate           DateTime?               @map("end_date") @db.Date
  adults            Int
  children          Int                     @default(0)
  budgetAmount      Decimal?                @map("budget_amount") @db.Decimal(10, 2)
  budgetCurrency    String?                 @map("budget_currency") @db.VarChar(10)
  notes             String?
  status            TailorMadeInquiryStatus @default(NEWLY_RECEIVED)
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")

  @@index([status])
  @@index([createdAt])
  @@map("tailor_made_inquiries")
}

model NotificationDeliveryLog {
  id                  String                     @id @default(uuid())
  notificationType    NotificationType           @map("notification_type")
  originReferenceCode String                     @map("origin_reference_code") @db.VarChar(50)
  originEntityType    String                     @map("origin_entity_type") @db.VarChar(50)
  recipientEmail      String                     @map("recipient_email") @db.VarChar(255)
  status              NotificationDeliveryStatus @default(PENDING)
  attempts            Int                        @default(0)
  lastAttemptAt       DateTime?                  @map("last_attempt_at")
  failureReason       String?                    @map("failure_reason")
  providerResponseId  String?                    @map("provider_response_id") @db.VarChar(255)
  createdAt           DateTime                   @default(now()) @map("created_at")
  updatedAt           DateTime                   @updatedAt @map("updated_at")

  @@index([originReferenceCode])
  @@index([status])
  @@map("notification_delivery_logs")
}

model ContactSubmission {
  id            Int                     @id @default(autoincrement())
  referenceCode String                  @unique @map("reference_code") @db.VarChar(20)
  status        ContactSubmissionStatus @default(NEW)
  firstName     String                  @map("first_name") @db.VarChar(100)
  lastName      String                  @map("last_name") @db.VarChar(100)
  email         String                  @db.VarChar(254)
  phone         String?                 @db.VarChar(30)
  subject       String                  @db.VarChar(200)
  message       String
  locale        String                  @default("en") @db.VarChar(10)
  ipAddress     String?                 @map("ip_address") @db.VarChar(45)
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @updatedAt @map("updated_at")

  @@index([status])
  @@index([email])
  @@index([createdAt])
  @@map("contact_submissions")
}

model MediaAsset {
  id           String          @id @default(uuid())
  publicId     String          @unique @map("public_id") @db.VarChar(255)
  url          String
  secureUrl    String          @map("secure_url")
  providerName String          @map("provider_name") @db.VarChar(100)
  format       String          @db.VarChar(20)
  mimeType     String          @map("mime_type") @db.VarChar(100)
  bytes        Int
  width        Int?
  height       Int?
  entityType   MediaEntityType @map("entity_type")
  entityId     String?         @map("entity_id") @db.VarChar(50)
  provenance   MediaProvenance
  altText      String?         @map("alt_text") @db.VarChar(255)
  uploadedBy   String?         @map("uploaded_by")
  deletedAt    DateTime?       @map("deleted_at")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  @@index([entityType, entityId])
  @@index([deletedAt])
  @@index([providerName])
  @@map("media_assets")
}

model Payment {
  id            String   @id @default(uuid())
  bookingId     String   @map("booking_id")
  amount        Decimal  @db.Decimal(10, 2)
  currency      String   @default("USD") @db.VarChar(10)
  method        String   @db.VarChar(100)
  transactionId String?  @map("transaction_id") @db.VarChar(255)
  status        PaymentStatus @default(PENDING)
  isRefund      Boolean  @default(false) @map("is_refund")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("payments")
}

model BookingActivityLog {
  id        String   @id @default(uuid())
  bookingId String   @map("booking_id")
  userId    String?  @map("user_id")
  action    String   @db.VarChar(255)
  details   Json?
  createdAt DateTime @default(now()) @map("created_at")
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])

  @@index([bookingId])
  @@map("booking_activity_logs")
}

model BookingNote {
  id        String   @id @default(uuid())
  bookingId String   @map("booking_id")
  userId    String   @map("user_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@index([bookingId])
  @@map("booking_notes")
}

model BookingAttachment {
  id           String   @id @default(uuid())
  bookingId    String   @map("booking_id")
  mediaAssetId String   @map("media_asset_id")
  uploadedBy   String?  @map("uploaded_by")
  createdAt    DateTime @default(now()) @map("created_at")
  booking      Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("booking_attachments")
}

model Wallet {
  id           String              @id @default(uuid())
  ownerType    WalletOwnerType     @map("owner_type")
  ownerId      String              @map("owner_id")
  currency     String              @default("USD") @db.VarChar(10)
  balance      Decimal             @default(0.00) @db.Decimal(12, 2)
  status       String              @default("ACTIVE") @db.VarChar(50)
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  transactions WalletTransaction[]

  @@unique([ownerType, ownerId])
  @@map("wallets")
}

model WalletTransaction {
  id            String                  @id @default(uuid())
  walletId      String                  @map("wallet_id")
  amount        Decimal                 @db.Decimal(10, 2)
  type          WalletTransactionType
  referenceType String                  @map("reference_type") @db.VarChar(50)
  referenceId   String?                 @map("reference_id")
  description   String?                 @db.VarChar(255)
  status        WalletTransactionStatus @default(COMPLETED)
  createdAt     DateTime                @default(now()) @map("created_at")
  wallet        Wallet                  @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([referenceType, referenceId])
  @@map("wallet_transactions")
}

model Commission {
  id        String           @id @default(uuid())
  companyId String           @map("company_id")
  bookingId String           @unique @map("booking_id")
  rate      Decimal          @db.Decimal(5, 2)
  amount    Decimal          @db.Decimal(10, 2)
  currency  String           @default("USD") @db.VarChar(10)
  status    CommissionStatus @default(PENDING)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  booking   Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([status])
  @@map("commissions")
}

enum UserRole {
  GUEST
  USER
  ADMIN
  SUPER_ADMIN
  COMPANY
  AGENT
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  PAID
  PARTIALLY_PAID
  REFUNDED
  ARCHIVED
}

enum InvoiceType {
  PERSONAL
  COMPANY
}

enum CompanyType {
  AGENCY
  CORPORATE
  AFFILIATE
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  BLACKLISTED
}

enum WalletOwnerType {
  USER
  COMPANY
}

enum WalletTransactionType {
  CREDIT
  DEBIT
}

enum WalletTransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  CANCELLED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  EXPIRED
}

enum TailorMadeInquiryStatus {
  NEWLY_RECEIVED
  IN_PROGRESS
  CLOSED
}

enum NotificationType {
  CUSTOMER_ACKNOWLEDGMENT
  INTERNAL_SALES_ALERT
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
  EXHAUSTED
}

enum ContactSubmissionStatus {
  NEW
  READ
  ARCHIVED
}

enum MediaEntityType {
  TOUR
  GENERAL
}

enum MediaProvenance {
  UPLOADED
  SEEDED
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?  @map("actor_id")
  actorRole  String?  @map("actor_role")
  action     String   @db.VarChar(255)
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model ProcessedWebhookEvent {
  id          String   @id
  provider    String   @db.VarChar(50)
  payload     Json?
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("processed_webhook_events")
}
