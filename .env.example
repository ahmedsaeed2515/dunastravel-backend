# Application
PORT=5000
NODE_ENV=production

# Frontend (CORS)
FRONTEND_URL=https://www.dunastravel.com
CORS_ALLOWED_ORIGINS=https://www.dunastravel.com,https://admin.dunastravel.com
ADMIN_DASHBOARD_BASE_URL=https://admin.dunastravel.com

# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Redis
REDIS_URL=redis://localhost:6379

# JWT Auth
JWT_SECRET=generate_a_secure_random_key_min_32_chars
JWT_REFRESH_SECRET=generate_a_secure_random_refresh_key_min_32_chars
JWT_EXPIRES_IN=7d

# Anthropic AI
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxx

# Resend Email Configuration
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=noreply@dunastravel.com
SALES_EMAIL=sales@dunastravel.com
MAIL_FROM_ADDRESS=noreply@dunastravel.com
MAIL_FROM_NAME=DunasTravel
MAIL_INTERNAL_ALERT_RECIPIENT=alerts@dunastravel.com

# Media (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Currency Exchange (OpenExchangeRates)
OPENEXCHANGERATES_APP_ID=your_app_id

# Stripe Payments
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxx
