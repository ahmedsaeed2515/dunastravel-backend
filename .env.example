# Application
# Numeric TCP port (Linux/Vercel) OR an IISNode named-pipe path on
# Windows/Plesk (e.g. \\.\pipe\iisnode-<id>). Pipe paths are passed verbatim.
PORT=5000
NODE_ENV=production

# Frontend (CORS)
FRONTEND_URL=https://dunas-travel.com
PUBLIC_API_URL=https://api.dunas-travel.com
CORS_ALLOWED_ORIGINS=https://dunas-travel.com,https://www.dunas-travel.com,https://stage.dunas-travel.com,https://dashboard.dunas-travel.com
ADMIN_DASHBOARD_BASE_URL=https://dashboard.dunas-travel.com
TRUST_PROXY_HOPS=1

# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Redis
REDIS_URL=redis://:replace_with_a_strong_password@redis:6379

# JWT Auth
JWT_SECRET=replace_with_a_distinct_high_entropy_secret_of_at_least_48_chars
JWT_REFRESH_SECRET=replace_with_another_distinct_high_entropy_secret_48_chars
JWT_EXPIRES_IN=15m
JWT_ISSUER=dunas-travel-api
JWT_AUDIENCE=dunas-travel-clients
GUEST_TOKEN_SECRET=replace_with_a_third_distinct_high_entropy_secret_48_chars
AUTH_REQUIRE_EMAIL_VERIFICATION=false
# Generate once with: openssl rand -hex 32
# Never rotate this without a data re-encryption migration.
PII_ENCRYPTION_KEY=

# Anthropic AI
AI_PROVIDER=anthropic
AI_PUBLIC_ENABLED=false
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=replace_with_an_enabled_model_name
AI_MAX_OUTPUT_TOKENS=1024
AI_REQUEST_TIMEOUT_MS=15000
AI_DAILY_QUOTA_PER_ADMIN=100

# Resend Email Configuration
MAIL_TRANSPORT=resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=noreply@dunastravel.com
SALES_EMAIL=sales@dunastravel.com
MAIL_FROM_ADDRESS=noreply@dunastravel.com
MAIL_FROM_NAME=DunasTravel
MAIL_INTERNAL_ALERT_RECIPIENT=alerts@dunastravel.com

# Media (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Currency Exchange (OpenExchangeRates)
OPENEXCHANGERATES_APP_ID=your_app_id

# Optional one-time account bootstrap. Leave unset during normal operation.
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=
ALLOW_PRODUCTION_ADMIN_BOOTSTRAP=false
SEED_DEMO_DATA=false
MANAGED_BACKUPS_CONFIRMED=false
# PayLink is server-side only. Never expose these through VITE_ or NEXT_PUBLIC_.
PAYMENT_PROVIDER=DISABLED
GETPAYIN_MODE=sandbox
GETPAYIN_BASE_URL=https://pay.getpayin.com
GETPAYIN_AUTH_TOKEN=
GETPAYIN_HASH_TOKEN=
GETPAYIN_REDIRECT_URL=https://dunas-travel.com/payment/return
GETPAYIN_WEBHOOK_URL=https://api.dunas-travel.com/api/payments/webhook/getpayin
GETPAYIN_TIMEOUT_MS=30000
GETPAYIN_MAX_RETRIES=2
