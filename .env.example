# Environment Configuration Example
# Copy this file to .env and configure it for your environment.

# Base Environment
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3001
CORS_ALLOWED_ORIGINS=http://localhost:3001
ADMIN_DASHBOARD_BASE_URL=http://localhost:3002

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dunastravel?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Auth Secrets (Must be 32+ chars and DIFFERENT from each other)
JWT_SECRET=replace-with-a-secure-random-string-at-least-32-chars-long
JWT_REFRESH_SECRET=replace-with-another-secure-random-string-at-least-32-chars-long
JWT_EXPIRES_IN=7d

# Limits
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Mailing (Resend)
RESEND_API_KEY=re_your_api_key_here
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=Dunas Travel
MAIL_INTERNAL_ALERT_RECIPIENT=alerts@example.com

# Media Assets (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Currency Exchange
OPENEXCHANGERATES_APP_ID=your_open_exchange_rates_app_id
