# Base Environment
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3001
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002
ADMIN_DASHBOARD_BASE_URL=http://localhost:3002

# Database
# Connects to the local Docker Compose postgres instance by default
DATABASE_URL=postgresql://postgres:password@localhost:5432/dunastravel_db
REDIS_URL=redis://localhost:6379

# Authentication
# Must be at least 32 characters
JWT_SECRET=super_secret_jwt_key_that_is_at_least_32_chars_long
JWT_EXPIRES_IN=7d

# Logging & Limits
LOG_LEVEL=info
REQUEST_TIMEOUT_MS=30000
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Mail (Resend)
RESEND_API_KEY=re_123456789
MAIL_FROM_ADDRESS=noreply@dunastravel.com
MAIL_FROM_NAME="Dunas Travel"
MAIL_INTERNAL_ALERT_RECIPIENT=sales@dunastravel.com
MAIL_TRANSPORT=mock

# Media (Cloudinary)
CLOUDINARY_CLOUD_NAME=my_cloud_name
CLOUDINARY_API_KEY=my_api_key
CLOUDINARY_API_SECRET=my_api_secret

# Currency (Open Exchange Rates)
OPENEXCHANGERATES_APP_ID=my_oer_app_id

# AI Platform Foundation
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-3-haiku-20240307
AI_MAX_OUTPUT_TOKENS=1024
AI_REQUEST_TIMEOUT_MS=15000
AI_DAILY_QUOTA_PER_ADMIN=50
