<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="dist/main.js" verb="*" modules="iisnode" />
    </handlers>
    
    <rewrite>
      <rules>
        <rule name="NodeInspector" patternSyntax="ECMAScript" stopProcessing="true">
          <match url="^dist\/main\.js\/debug[\/]?" />
        </rule>
        <rule name="LogFile" patternSyntax="ECMAScript" stopProcessing="true">
          <match url="^[a-zA-Z0-9_\-]+\.js\.logs\/" />
        </rule>
        <rule name="DynamicContent">
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="True" />
          </conditions>
          <action type="Rewrite" url="dist/main.js" />
        </rule>
      </rules>
    </rewrite>

    <iisnode
      watchedFiles="web.config;dist\main.js"
      loggingEnabled="true"
      debuggingEnabled="false"
      devErrorsEnabled="true"
    />

    <!-- Prevent IIS from replacing structured NestJS API JSON errors with HTML -->
    <httpErrors errorMode="Detailed" existingResponse="PassThrough" />

    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="52428800" />
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment=".env" />
          <add segment=".env.production" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
