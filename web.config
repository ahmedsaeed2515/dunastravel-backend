<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- Prevent IIS/Plesk from replacing structured NestJS API JSON errors with its own generic HTML error pages -->
    <httpErrors errorMode="Detailed" existingResponse="PassThrough" />
    
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="52428800" />
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment=".env" />
          <add segment=".env.production" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
